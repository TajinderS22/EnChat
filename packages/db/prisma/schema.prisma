generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int            @id @default(autoincrement())
  username  String         @unique
  firstname String
  lastname  String?
  password  String
  email     String
  createdAt DateTime       @default(now())

  Chatrooms ChatroomUsers[]
  Messages  Messages[]

}


model Chatrooms{
  id         Int            @id @default(autoincrement())
  userId     Int  
  createdAt  DateTime       @default(now())

  users      ChatroomUsers[]
  messages   Messages[]
  
}

model Messages{
  id          Int         @id @default(autoincrement())
  userId      Int 
  chatroomId  Int
  message     String
  createdAt   DateTime    @default(now())

  user        User        @relation(fields:[userId],references: [id])
  chatroom    Chatrooms   @relation(fields: [chatroomId],references: [id])

}

model ChatroomUsers{
  
  chatroomId  Int
  userId      Int
  joinedAt    DateTime    @default(now())

  user        User        @relation(fields: [userId],references:[id])
  chatroom    Chatrooms   @relation(fields: [chatroomId],references: [id])
  


  @@id([userId, chatroomId])

} 
