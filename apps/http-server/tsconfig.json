{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@repo/db": ["../../packages/db/src"],
      "@repo/encryption": ["../../packages/encryption/src"],
      "@repo/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src", "index.ts"]
}
