{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true
  },
  "include": ["src", "index.ts"],
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/encryption" },
    { "path": "../../packages/ui" }
  ]
}
