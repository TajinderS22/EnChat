{
  "name": "EnChat",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build:force": "turbo run build --force"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.8.13",
    "typescript": "5.8.3",
    "prisma": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "react-redux": "^9.2.0"
  },
  "overrides": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1"
  }
}